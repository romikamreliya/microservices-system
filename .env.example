NAME = "Microservice-sys"
ENV = "development"
DEBUG = true
HTTPS_ENABLED = false
ENABLE_MEMORY_MONITORING = false

# CORS Configuration
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080,https://yourdomain.com"

#DB
DB_TYPE = "sqlite" # mysql, sqlite
# # sqlite
DATABASE_URL="file:./dev.db" #sqlite
# # mysql
DB_HOST= "127.0.0.1"
DB_PORT= "3306"
DB_DATABASE= "your_database"
DB_USER= "your_db_user"
DB_PASSWORD= "your_db_password"

# Token
accessTokenKey = ""          # JWT access-token signing secret
refreshTokenKey = ""         # refresh-token HMAC secret (legacy misspelling "refressTokenKey" still accepted)
tokenEncryptionKey = ""      # AES token encryption key (falls back to accessTokenKey if empty)
tokenEncryptionSalt = ""     # PBKDF2 salt for the AES key (falls back to a default if empty)

# Mail
service = 'gmail'
host = 'smtp.gmail.com'
port = 465
secure = true
user = ''
pass = ''

# Upload Path
path = "./public"

#Language
default_language = "en"
